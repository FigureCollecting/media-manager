# syntax=docker/dockerfile:1
#
# --- BiRefNet matting backend: base image + CUDA/cuDNN pin rationale ------
# onnxruntime-gpu 1.27.0 (latest on PyPI as of this writing, released
# 2026-06-18) dropped CUDA 12 as its default GPU package: its own release
# notes say "CUDA 12 packages are deprecated, please move to CUDA 13
# ASAP", and its optional pip extras confirm the pairing it was actually
# built against --
#   nvidia-cuda-runtime-cu13 ~=13.0   (extra "cuda")
#   nvidia-cudnn-cu13        ~=9.0    (extra "cudnn")
# i.e. CUDA 13.x + cuDNN 9.x. A mismatched CUDA/cuDNN does NOT fail the
# build or the container start -- onnxruntime silently falls back to
# CPUExecutionProvider (the same hazard class as any nvidia-cudnn
# cu12/cu13 pip-wheel collision: a mismatched wheel overwrites the .so
# files a GPU library expects, and the failure is silent, not a crash).
# Rather than lean on the pip [cuda]/[cudnn] extras alone, this image
# bases directly on an NVIDIA CUDA 13 image that already ships matching
# CUDA 13.x runtime + cuDNN 9.x system libraries via LD_LIBRARY_PATH, so
# there is one single, verifiable source of truth for the pin.
# app.workers.matting.BiRefNetMattingBackend._get_session() additionally
# checks at runtime that CUDAExecutionProvider actually loaded and raises
# rather than silently degrading if it didn't.
#
# Tag verified to exist via the Docker Hub v2 API (nvidia/cuda tags,
# name=cudnn-runtime-ubuntu24.04) at authoring time.
FROM nvidia/cuda:13.3.0-cudnn-runtime-ubuntu24.04 AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    PATH="/opt/venv/bin:${PATH}"

# Ubuntu 24.04 (this base image's OS) ships Python 3.12 via apt, matching
# the python = "^3.12" pin in pyproject.toml. python3.12-venv is used
# (rather than pip --break-system-packages) because Ubuntu's apt-installed
# Python is PEP 668 externally-managed -- a venv is the clean way around
# that inside a single-purpose container. libvips42t64 is Ubuntu 24.04's
# actual runtime package name for libvips (verified via apt-cache madison;
# renamed with the "t64" suffix from Debian's plain "libvips" as part of
# Ubuntu noble's 64-bit time_t transition).
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.12 \
    python3.12-venv \
    build-essential \
    libpq-dev \
    libvips42t64 \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && python3.12 -m venv /opt/venv

WORKDIR /app

COPY pyproject.toml /app/

RUN pip install --no-cache-dir poetry==1.8.3 && \
    poetry export -f requirements.txt --only main -o /tmp/requirements.txt --without-hashes && \
    pip install --no-cache-dir -r /tmp/requirements.txt

# onnxruntime-gpu is intentionally NOT a pyproject.toml dependency: it's a
# deploy-only, GPU-only package (see app/workers/matting.py module
# docstring) that application code and tests never import directly, so
# the shared dependency set -- and CI, which never builds this image --
# stays GPU-free. Pinned exactly to match the base image's CUDA 13.x /
# cuDNN 9.x pair documented above.
RUN pip install --no-cache-dir onnxruntime-gpu==1.27.0

# --- Matting weights: exactly the bytes the mask lane was measured on -----
# MASK-1's live acceptance (2026-10-11: the seven July figures, IoU 0.91-0.99
# against the July cut-outs) ran on rembg's release assets (danielgatis/rembg,
# MIT; release v0.0.0): BiRefNet-general (the fp32 export of ZhengPeng7/
# BiRefNet, MIT) and the two IS-Net (DIS) exports the ported July base-keep
# pass uses as base donors (app.workers.basekept). Each is pinned by sha-256
# below (and matches rembg's own md5 pin), so the image can only carry the
# weights that were measured. The earlier fp16 export of a DIFFERENT BiRefNet
# conversion (onnx-community/BiRefNet-ONNX, ~490MB) was never measured against
# the July references, so it is not baked; it would roughly halve this layer
# (the fp32 file is ~973MB) only after its own measurement.
#
# NOTE: the weight paths are set here so the weights are always present, but
# MATTING_BACKEND is deliberately left unset -- activating "birefnet" or
# "birefnet_basekept" (vs. the CPU-only "stub" default) is a runtime
# deploy-environment decision (e.g. a k3s env var on a GPU node), not baked
# into the image itself: both refuse to run without CUDAExecutionProvider
# rather than silently degrading to CPU, so a GPU-less run of this image
# (local docker-compose dev) would fail every matte request. The stub is dry
# run only for masks (app.workers.mask_job refuses to apply with it).
ENV MATTING_MODEL_PATH=/models/birefnet/BiRefNet-general-epoch_244.onnx \
    MATTING_ISNET_GENERAL_PATH=/models/isnet/isnet-general-use.onnx \
    MATTING_ISNET_ANIME_PATH=/models/isnet/isnet-anime.onnx
RUN set -eu; \
    mkdir -p /models/birefnet /models/isnet; \
    rembg="https://github.com/danielgatis/rembg/releases/download/v0.0.0"; \
    curl -fL "${rembg}/BiRefNet-general-epoch_244.onnx" -o "${MATTING_MODEL_PATH}"; \
    curl -fL "${rembg}/isnet-general-use.onnx" -o "${MATTING_ISNET_GENERAL_PATH}"; \
    curl -fL "${rembg}/isnet-anime.onnx" -o "${MATTING_ISNET_ANIME_PATH}"; \
    printf '%s  %s\n' \
      58f621f00f5d756097615970a88a791584600dcf7c45b18a0a6267535a1ebd3c "${MATTING_MODEL_PATH}" \
      60920e99c45464f2ba57bee2ad08c919a52bbf852739e96947fbb4358c0d964a "${MATTING_ISNET_GENERAL_PATH}" \
      f15622d853e8260172812b657053460e20806f04b9e05147d49af7bed31a6e99 "${MATTING_ISNET_ANIME_PATH}" \
      | sha256sum -c -

COPY app /app/app

CMD ["celery", "-A", "app.workers.celery_app", "worker", "-l", "INFO"]
