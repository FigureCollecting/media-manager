# Core (ENVIRONMENT is required: development, test or production; there is no default)
ENVIRONMENT=development
LOG_LEVEL=INFO

# JWT
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
TOKEN_EXP_MINUTES=60
REFRESH_TOKEN_EXP_MINUTES=10080
ALLOW_DEV_TOKENS=false

# Postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/media_manager

# Redis
REDIS_URL=redis://redis:6379/0

# S3 / MinIO
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=images
S3_SECURE=false

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5051,https://figurecollecting.com
